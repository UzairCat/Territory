# Railway supplies PORT automatically. TERRITORY_SERVER_PORT is the local fallback.
# Local defaults work without an env file. Production hosts should set the origin after a domain exists.
TERRITORY_SERVER_PORT=3001
TERRITORY_CLIENT_ORIGINS=https://territory.example.com
TERRITORY_SERVE_CLIENT=true

# Only needed when the web client and multiplayer server use different origins.
# VITE_MULTIPLAYER_URL=https://territory-api.example.com
